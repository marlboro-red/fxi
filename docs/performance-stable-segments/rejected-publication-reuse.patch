diff --git a/src/index/publication_checks.rs b/src/index/publication_checks.rs
new file mode 100644
index 0000000..f83d1ca
--- /dev/null
+++ b/src/index/publication_checks.rs
@@ -0,0 +1,107 @@
+//! Optional reuse of strict publication validation for immutable segments.
+//!
+//! Bind the actual dictionary, posting bytes, existing query checks, and exact
+//! document membership. Hashing all dependencies still detects same-length edits
+//! with restored timestamps. This shares the query-check accidental-corruption
+//! model, not authentication against a party able to rewrite checks coherently.
+use super::reader::MappedBytes;
+use anyhow::Result;
+use roaring::RoaringBitmap;
+use std::path::Path;
+use xxhash_rust::xxh3::{Xxh3, xxh3_64};
+
+const NAME: &str = "publication.check";
+const MAGIC: &[u8; 8] = b"FXIPUB01";
+
+fn membership_hash(ids: &RoaringBitmap) -> u64 {
+    let mut hash = Xxh3::new();
+    for id in ids {
+        hash.update(&id.to_le_bytes());
+    }
+    hash.digest()
+}
+
+fn evidence(
+    path: &Path,
+    dictionary: &[u8],
+    postings: &[u8],
+    ids: &RoaringBitmap,
+) -> Result<Vec<u8>> {
+    let checks = MappedBytes::open(&path.join("grams.checks"))?;
+    let mut bytes = MAGIC.to_vec();
+    for hash in [
+        xxh3_64(dictionary),
+        xxh3_64(postings),
+        xxh3_64(&checks),
+        membership_hash(ids),
+    ] {
+        bytes.extend_from_slice(&hash.to_le_bytes());
+    }
+    bytes.extend_from_slice(&xxh3_64(&bytes).to_le_bytes());
+    Ok(bytes)
+}
+
+/// Only call after strict validation, while the segment is private. Never
+/// retrofit evidence into an already published object.
+pub(crate) fn write(
+    path: &Path,
+    dictionary: &[u8],
+    postings: &[u8],
+    ids: &RoaringBitmap,
+) -> Result<()> {
+    std::fs::write(path.join(NAME), evidence(path, dictionary, postings, ids)?)?;
+    Ok(())
+}
+
+/// Invalid/missing optional evidence declines reuse; the caller must validate.
+pub(crate) fn certifies(
+    path: &Path,
+    dictionary: &[u8],
+    postings: &[u8],
+    ids: &RoaringBitmap,
+) -> bool {
+    (|| -> Result<bool> {
+        let bytes = std::fs::read(path.join(NAME))?;
+        if bytes.len() != 48 || &bytes[..8] != MAGIC {
+            return Ok(false);
+        }
+        Ok(bytes == evidence(path, dictionary, postings, ids)?)
+    })()
+    .unwrap_or(false)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn binds_every_dependency_and_declines_damaged_optional_evidence() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path();
+        let ids: RoaringBitmap = [1, 3, 7].into_iter().collect();
+        std::fs::write(path.join("grams.checks"), b"checks").unwrap();
+        assert!(!certifies(path, b"dict", b"postings", &ids));
+        write(path, b"dict", b"postings", &ids).unwrap();
+        assert!(certifies(path, b"dict", b"postings", &ids));
+        assert!(!certifies(path, b"Dict", b"postings", &ids));
+        assert!(!certifies(path, b"dict", b"PostingS", &ids));
+        assert!(!certifies(
+            path,
+            b"dict",
+            b"postings",
+            &[1, 3, 8].into_iter().collect()
+        ));
+        std::fs::write(path.join("grams.checks"), b"Checks").unwrap();
+        assert!(!certifies(path, b"dict", b"postings", &ids));
+        std::fs::write(path.join("grams.checks"), b"checks").unwrap();
+        let original = std::fs::read(path.join(NAME)).unwrap();
+        for i in 0..original.len() {
+            let mut damaged = original.clone();
+            damaged[i] ^= 1;
+            std::fs::write(path.join(NAME), damaged).unwrap();
+            assert!(!certifies(path, b"dict", b"postings", &ids));
+        }
+        std::fs::remove_file(path.join(NAME)).unwrap();
+        assert!(!certifies(path, b"dict", b"postings", &ids));
+    }
+}
