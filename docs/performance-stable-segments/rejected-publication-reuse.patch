+#[test]
+fn publication_proof_fallback_preserves_objects_and_rejects_hidden_payload_damage() {
+    for profile in ["full", "lean"] {
+        for missing in [false, true] {
+            let f = Fixture::new();
+            let mode = CheckedMode::Generation;
+            f.checked_ok(
+                true,
+                mode,
+                &["index", "--profile", profile, "--chunk-size", "8"],
+            );
+            let object = f.object_paths().remove(0);
+            let proof = object.join("publication.check");
+            assert_eq!(fs::metadata(&proof).unwrap().len(), 48);
+            if missing {
+                fs::remove_file(&proof).unwrap();
+            } else {
+                fs::write(&proof, b"invalid optional proof").unwrap();
+            }
+            let objects = f.snapshot_objects();
+            fs::write(f.root.join("new.rs"), "newMarker shared\n").unwrap();
+            f.checked_ok(false, mode, &["index"]);
+            assert_objects_unchanged(&objects);
+            f.assert_source_queries(mode);
+        }
+
+        let f = Fixture::new();
+        let mode = CheckedMode::Generation;
+        f.checked_ok(
+            true,
+            mode,
+            &["index", "--profile", profile, "--chunk-size", "8"],
+        );
+        let current = fs::read(f.container().join("CURRENT")).unwrap();
+        let object = f.object_paths().remove(0);
+        let postings = object.join("grams.postings");
+        let modified = fs::metadata(&postings).unwrap().modified().unwrap();
+        let mut bytes = fs::read(&postings).unwrap();
+        bytes[0] ^= 1;
+        fs::write(&postings, bytes).unwrap();
+        fs::OpenOptions::new()
+            .write(true)
+            .open(&postings)
+            .unwrap()
+            .set_modified(modified)
+            .unwrap();
+        fs::write(f.root.join("new.rs"), "newMarker shared\n").unwrap();
+        let result = f
+            .checked_command(false, mode)
+            .arg("index")
+            .output()
+            .unwrap();
+        assert!(!result.status.success(), "{profile}");
+        assert_eq!(fs::read(f.container().join("CURRENT")).unwrap(), current);
+    }
+}
