+    /// Assign document IDs in payload order, keeping sequential posting walks
+    /// local without retaining or copying source bytes to reorder the pack.
+    pub(crate) fn order<T>(&self, files: &mut [T], path: impl Fn(&T) -> &Path) -> Result<()> {
+        let state = self
+            .state
+            .lock()
+            .map_err(|_| anyhow::anyhow!("Source capture writer poisoned"))?;
+        files.sort_by_cached_key(|file| {
+            state
+                .entries
+                .get(path(file))
+                .map_or(u64::MAX, |entry| entry.record[2])
+        });
