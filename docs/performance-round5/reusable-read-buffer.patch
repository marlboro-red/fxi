+    #[test]
+    fn reusable_scan_buffer_rejects_errors_and_does_not_leak_previous_content() {
+        let (_temp_dir, root) = create_test_index();
+        let reader = IndexReader::open_uncached(&root).unwrap();
+        let path = root.join("scratch.txt");
+        let mut scratch = String::new();
+        for text in ["needle".repeat(10000), "tiny café\r\n".into(), "".into()] {
+            fs::write(&path, &text).unwrap();
+            assert_eq!(
+                reader.with_file_for_scan(&path, false, &mut scratch, str::to_owned),
+                Some(text)
+            );
+        }
+        fs::write(&path, b"needle\xff").unwrap();
+        assert!(
+            reader
+                .with_file_for_scan(&path, false, &mut scratch, |_| panic!("invalid UTF-8"))
+                .is_none()
+        );
+        fs::remove_file(&path).unwrap();
+        assert!(
+            reader
+                .with_file_for_scan(&path, false, &mut scratch, |_| panic!("missing file"))
+                .is_none()
+        );
+        fs::write(&path, "fresh").unwrap();
+        assert_eq!(
+            reader.with_file_for_scan(&path, false, &mut scratch, str::to_owned),
+            Some("fresh".into())
+        );
+    }
+
