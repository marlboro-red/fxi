+    /// Reuse a worker-owned buffer when admission is disabled. The callback
+    /// cannot retain a borrow across the next read; UTF-8 and I/O errors still
+    /// reject the whole file before verification.
+    pub(crate) fn with_file_for_scan<T>(
+        &self,
+        path: &Path,
+        cache_scan: bool,
+        scratch: &mut String,
+        verify: impl FnOnce(&str) -> T,
+    ) -> Option<T> {
+        if !self.content_cache_enabled || self.file_cache.max_bytes == 0 {
+            scratch.clear();
+            File::open(path).ok()?.read_to_string(scratch).ok()?;
+            Some(verify(scratch))
+        } else {
+            self.read_file_for_scan(path, cache_scan)
+                .map(|content| verify(&content))
+        }
+    }
+
