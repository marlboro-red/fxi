+/// Stable counting inversion over the 24-bit gram universe. The zeroed
+/// offset table is sparse in physical memory on demand-paged allocators; only
+/// encountered grams are enumerated, so no full-universe scan is needed.
+fn invert_trigram_postings(files: &mut [AssignedFile]) -> Vec<(u32, DocId)> {
+    let total: usize = files.iter().map(|f| f.trigrams.len()).sum();
+    if total == 0 {
+        return Vec::new();
+    }
+    // Keep the writer's general u32-key API, including caller-constructed
+    // ProcessedFile values outside the extractor's 24-bit gram universe.
+    if total > u32::MAX as usize
+        || files
+            .iter()
+            .any(|f| f.trigrams.iter().any(|&g| g > 0xffffff))
+    {
+        let mut pairs = Vec::with_capacity(total);
+        for file in files {
+            pairs.extend(
+                std::mem::take(&mut file.trigrams)
+                    .into_iter()
+                    .map(|g| (g, file.doc_id)),
+            );
+        }
+        pairs.par_sort_unstable();
+        return pairs;
+    }
+    let mut offsets = vec![0u32; 1 << 24];
+    let mut touched = Vec::new();
+    for file in files.iter() {
+        for &gram in &file.trigrams {
+            let count = &mut offsets[gram as usize];
+            if *count == 0 {
+                touched.push(gram);
+            }
+            *count += 1;
+        }
+    }
+    touched.sort_unstable();
+    let mut next = 0;
+    for gram in touched {
+        let count = offsets[gram as usize];
+        offsets[gram as usize] = next;
+        next += count;
+    }
+    let mut pairs = vec![(0, 0); total];
+    for file in files {
+        for gram in std::mem::take(&mut file.trigrams) {
+            let offset = &mut offsets[gram as usize];
+            pairs[*offset as usize] = (gram, file.doc_id);
+            *offset += 1;
+        }
+    }
+    pairs
+}
